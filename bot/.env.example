# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# SQLite file (default: ./pons.db)
DB_PATH=./pons.db

# Days of launch history to backfill (default 7)
BACKFILL_DAYS=7

# Chat id that receives the daily /scout digest (10:00 Europe/Bratislava).
# Leave empty to post nothing; /scout in a DM works either way.
CREW_CHAT_ID=
