{
  "name": "pons-scan-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bot": "node dist/index.js bot",
    "backfill": "node dist/index.js backfill",
    "index": "node dist/index.js index",
    "recheck": "node dist/index.js recheck",
    "verify": "node dist/index.js verify",
    "scan": "node dist/index.js scan",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "decode": "node dist/index.js decode",
    "test": "node --test test/*.test.mjs",
    "test:live": "node test/handlers.mjs && node test/flags-live.mjs && node test/errors.mjs && node test/integration.mjs && node test/deadline.mjs && node test/properties.mjs && node test/early-live.mjs",
    "build:fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^11.7.0",
    "grammy": "^1.30.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "wawoff2": "^2.0.1"
  }
}